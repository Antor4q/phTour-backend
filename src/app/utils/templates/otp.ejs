<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Verify Your Email</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f8;
      color: #1f2937;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 520px;
    }

    .card {
      background: #ffffff;
      border-radius: 16px;
      padding: 45px 40px;
      text-align: center;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .logo {
      width: 55px;
      height: 55px;
      margin: 0 auto 25px;
      border-radius: 14px;
      background: #111827;
      color: #ffffff;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 20px;
      font-weight: 700;
    }

    h1 {
      font-size: 27px;
      margin-bottom: 12px;
      color: #111827;
    }

    .description {
      font-size: 15px;
      line-height: 1.7;
      color: #6b7280;
      margin-bottom: 30px;
    }

    .otp-box {
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 12px;

      padding: 18px 20px;
      margin: 25px 0;
    }

    .otp {
      font-size: 34px;
      font-weight: 700;
      letter-spacing: 10px;
      color: #111827;
      margin-left: 10px;
    }

    .expiry {
      font-size: 13px;
      color: #9ca3af;
      margin-top: 8px;
    }

    .warning {
      font-size: 13px;
      line-height: 1.6;
      color: #6b7280;
      margin-top: 25px;
    }

    /* .footer {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #eeeeee;

      font-size: 12px;
      color: #9ca3af;
    } */

    @media (max-width: 480px) {
      .card {
        padding: 35px 22px;
      }

      h1 {
        font-size: 23px;
      }

      .otp {
        font-size: 28px;
        letter-spacing: 7px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="card">

      <div class="logo">
        A
      </div>

      <h1>Hi <%= name %>, Verify Your Email</h1>

      <p class="description">
        Use the verification code below to verify your email address
        and continue your account setup.
      </p>

      <div class="otp-box">

        <div class="otp">
          <%= otp %>
        </div>

        <div class="expiry">
          This code will expire in 10 minutes.
        </div>

      </div>

      <p class="warning">
        If you didn't request this verification code, you can safely
        ignore this email. Never share this code with anyone.
      </p>

      <!-- <div class="footer">
        © <%= new Date().getFullYear() %> Your App. All rights reserved.
      </div> -->

    </div>

  </div>

</body>
</html>