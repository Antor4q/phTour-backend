<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Your Booking Invoice</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    font-family: Arial, Helvetica, sans-serif;
    color: #111827;
">

<table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color: #f4f6f8; padding: 40px 15px;"
>
    <tr>
        <td align="center">

            <!-- Main Container -->
            <table
                width="600"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                    max-width: 600px;
                    width: 100%;
                    background-color: #ffffff;
                    border-radius: 12px;
                    overflow: hidden;
                "
            >

                <!-- Header -->
                <tr>
                    <td
                        style="
                            padding: 30px 35px;
                            border-bottom: 1px solid #e5e7eb;
                        "
                    >

                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tr>

                                <td>
                                    <div style="
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: #111827;
                                    ">
                                        Invoice
                                    </div>

                                    <div style="
                                        margin-top: 6px;
                                        font-size: 13px;
                                        color: #6b7280;
                                    ">
                                        Tour Booking Invoice
                                    </div>
                                </td>

                                <td align="right">
                                    <div style="
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: #111827;
                                    ">
                                        TOURGO
                                    </div>

                                    <div style="
                                        margin-top: 5px;
                                        font-size: 11px;
                                        color: #6b7280;
                                    ">
                                        Your trusted travel partner
                                    </div>
                                </td>

                            </tr>
                        </table>

                    </td>
                </tr>


                <!-- Greeting -->
                <tr>
                    <td style="padding: 30px 35px 10px 35px;">

                        <div style="
                            font-size: 16px;
                            font-weight: 700;
                            color: #111827;
                        ">
                            Hi <%= userName %>,
                        </div>

                        <div style="
                            margin-top: 8px;
                            font-size: 13px;
                            line-height: 1.7;
                            color: #6b7280;
                        ">
                            Your tour booking has been successfully confirmed.
                            Please find your booking invoice details below.
                        </div>

                    </td>
                </tr>


                <!-- Payment Status -->
                <tr>
                    <td style="padding: 20px 35px;">

                        <div style="
                            display: inline-block;
                            padding: 8px 12px;
                            background-color: #dcfce7;
                            border-radius: 6px;
                            color: #15803d;
                            font-size: 11px;
                            font-weight: 700;
                        ">
                            ✓ PAYMENT CONFIRMED
                        </div>

                    </td>
                </tr>


                <!-- Invoice Information -->
                <tr>
                    <td style="padding: 0 35px 25px 35px;">

                        <table
                            width="100%"
                            cellpadding="0"
                            cellspacing="0"
                            border="0"
                            style="
                                background-color: #f9fafb;
                                border-radius: 8px;
                            "
                        >

                            <tr>

                                <td style="
                                    padding: 18px;
                                    width: 50%;
                                    vertical-align: top;
                                ">

                                    <div style="
                                        font-size: 10px;
                                        font-weight: 700;
                                        text-transform: uppercase;
                                        color: #9ca3af;
                                        margin-bottom: 7px;
                                    ">
                                        Transaction ID
                                    </div>

                                    <div style="
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #111827;
                                        word-break: break-all;
                                    ">
                                        <%= transactionId %>
                                    </div>

                                </td>


                                <td style="
                                    padding: 18px;
                                    width: 50%;
                                    vertical-align: top;
                                ">

                                    <div style="
                                        font-size: 10px;
                                        font-weight: 700;
                                        text-transform: uppercase;
                                        color: #9ca3af;
                                        margin-bottom: 7px;
                                    ">
                                        Booking Date
                                    </div>

                                    <div style="
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #111827;
                                    ">
                                        <%= new Date(bookingDate).toLocaleDateString("en-GB") %>
                                    </div>

                                </td>

                            </tr>

                        </table>

                    </td>
                </tr>


                <!-- Booking Summary -->
                <tr>
                    <td style="padding: 0 35px 10px 35px;">

                        <div style="
                            font-size: 16px;
                            font-weight: 700;
                            color: #111827;
                            margin-bottom: 15px;
                        ">
                            Booking Summary
                        </div>

                    </td>
                </tr>


                <!-- Tour Table -->
                <tr>
                    <td style="padding: 0 35px;">

                        <table
                            width="100%"
                            cellpadding="0"
                            cellspacing="0"
                            border="0"
                            style="
                                border: 1px solid #e5e7eb;
                                border-radius: 8px;
                                overflow: hidden;
                            "
                        >

                            <!-- Table Header -->
                            <tr style="background-color: #f3f4f6;">

                                <td style="
                                    padding: 12px 15px;
                                    font-size: 10px;
                                    font-weight: 700;
                                    text-transform: uppercase;
                                    color: #374151;
                                ">
                                    Tour
                                </td>

                                <td
                                    align="center"
                                    style="
                                        padding: 12px 10px;
                                        font-size: 10px;
                                        font-weight: 700;
                                        text-transform: uppercase;
                                        color: #374151;
                                    "
                                >
                                    Guests
                                </td>

                                <td
                                    align="right"
                                    style="
                                        padding: 12px 15px;
                                        font-size: 10px;
                                        font-weight: 700;
                                        text-transform: uppercase;
                                        color: #374151;
                                    "
                                >
                                    Amount
                                </td>

                            </tr>


                            <!-- Table Row -->
                            <tr>

                                <td style="
                                    padding: 20px 15px;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #111827;
                                    border-top: 1px solid #e5e7eb;
                                ">
                                    <%= tourTitle %>
                                </td>

                                <td
                                    align="center"
                                    style="
                                        padding: 20px 10px;
                                        font-size: 13px;
                                        color: #374151;
                                        border-top: 1px solid #e5e7eb;
                                    "
                                >
                                    <%= guestCount %>
                                </td>

                                <td
                                    align="right"
                                    style="
                                        padding: 20px 15px;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #111827;
                                        border-top: 1px solid #e5e7eb;
                                    "
                                >
                                    ৳<%= Number(totalAmount).toFixed(2) %>
                                </td>

                            </tr>

                        </table>

                    </td>
                </tr>


                <!-- Total -->
                <tr>
                    <td style="padding: 25px 35px 10px 35px;">

                        <table
                            width="100%"
                            cellpadding="0"
                            cellspacing="0"
                            border="0"
                        >

                            <tr>

                                <td
                                    align="right"
                                    style="
                                        padding-bottom: 12px;
                                        font-size: 13px;
                                        color: #6b7280;
                                    "
                                >
                                    Subtotal
                                </td>

                                <td
                                    align="right"
                                    width="130"
                                    style="
                                        padding-bottom: 12px;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #111827;
                                    "
                                >
                                    ৳<%= Number(totalAmount).toFixed(2) %>
                                </td>

                            </tr>


                            <tr>

                                <td
                                    align="right"
                                    style="
                                        border-top: 1px solid #e5e7eb;
                                        padding-top: 15px;
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: #111827;
                                    "
                                >
                                    Total
                                </td>

                                <td
                                    align="right"
                                    style="
                                        border-top: 1px solid #e5e7eb;
                                        padding-top: 15px;
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: #16a34a;
                                    "
                                >
                                    ৳<%= Number(totalAmount).toFixed(2) %>
                                </td>

                            </tr>

                        </table>

                    </td>
                </tr>


                <!-- Thank You -->
                <tr>
                    <td
                        align="center"
                        style="padding: 40px 35px 25px 35px;"
                    >

                        <div style="
                            font-size: 17px;
                            font-weight: 700;
                            color: #111827;
                        ">
                            Thank you for booking with us!
                        </div>

                        <div style="
                            margin-top: 7px;
                            font-size: 12px;
                            color: #6b7280;
                        ">
                            We hope you have a wonderful journey.
                        </div>

                    </td>
                </tr>


                <!-- Footer -->
                <tr>
                    <td
                        align="center"
                        style="
                            padding: 20px 35px;
                            border-top: 1px solid #e5e7eb;
                            background-color: #fafafa;
                        "
                    >

                        <div style="
                            font-size: 10px;
                            line-height: 1.6;
                            color: #9ca3af;
                        ">
                            This is a computer-generated invoice and
                            does not require a signature.
                        </div>

                        <div style="
                            margin-top: 5px;
                            font-size: 10px;
                            color: #9ca3af;
                        ">
                            © 2026 TOURGO. All rights reserved.
                        </div>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>